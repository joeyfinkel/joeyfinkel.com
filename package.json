{
	"name": "joeyfinkel.com",
	"private": true,
	"type": "module",
	"portless": "joeyfinkel",
	"packageManager": "pnpm@10.33.2",
	"engines": {
		"node": ">=24.18.0 <25"
	},
	"scripts": {
		"dev": "portless run vite",
		"build": "node scripts/generate-og-image.mjs && vite build",
		"og": "node scripts/generate-og-image.mjs",
		"preview": "portless run vite preview",
		"check": "biome check .",
		"format": "biome check --write .",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
		"deploy": "pnpm build && wrangler deploy",
		"deploy:check": "wrangler deploy --dry-run",
		"test": "vitest run",
		"cf-typegen": "wrangler types"
	},
	"dependencies": {
		"@cloudflare/workers-oauth-provider": "^1.2.4",
		"@jfdevelops/react-layout": "2.5.0",
		"@jfdevelops/react-layout-composable-breadcrumb": "^0.2.12",
		"@jfdevelops/react-layout-composables": "^0.5.0",
		"@jfdevelops/react-layout-devtools-react": "^0.4.0",
		"@jfdevelops/react-layout-devtools-vite": "^0.1.2",
		"@jfdevelops/react-layout-validator": "^0.4.0",
		"@modelcontextprotocol/server": "2.4.0",
		"@radix-ui/react-dialog": "^1.3.1",
		"@radix-ui/react-slot": "^1.5.0",
		"@tanstack/react-form": "^1.33.5",
		"@tanstack/react-router": "^1.170.46",
		"agents": "^0.32.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cn": "^0.5.2",
		"lucide-react": "^1.65.0",
		"next-themes": "^0.4.6",
		"pdf-lib": "^1.17.1",
		"prism-react-renderer": "^2.4.1",
		"prismjs": "^1.30.0",
		"radix-ui": "^1.8.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"tailwind-merge": "^3.7.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.4",
		"@cloudflare/vite-plugin": "^1.66.0",
		"@cloudflare/vitest-plugin": "^1.4.11",
		"@fontsource/inter": "^5.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/devtools-vite": "^0.8.6",
		"@tanstack/react-devtools": "^0.10.14",
		"@tanstack/react-router-devtools": "^1.167.2",
		"@tanstack/router-plugin": "^1.168.48",
		"@types/node": "^24.19.2",
		"@types/prismjs": "^1.26.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"portless": "^0.15.12",
		"satori": "^0.63.2",
		"sharp": "^0.35.5",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^7.0.2",
		"vite": "^8.3.5",
		"vitest": "^5.0.5",
		"wrangler": "^4.156.0"
	}
}
