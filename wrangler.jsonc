{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "joeyfinkel-com",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-30",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"vars": { "SITE_ORIGIN": "https://joeyfinkel.com" },
	"secrets": { "required": ["PUBLISH_PASSWORD"] },
	"r2_buckets": [{ "binding": "RESUMES", "bucket_name": "joeyfinkel-resumes" }],
	"kv_namespaces": [{ "binding": "OAUTH_KV" }],
	"ratelimits": [
		{
			"name": "AUTH_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 5, "period": 60 }
		}
	],
	"observability": { "enabled": true, "traces": { "enabled": true } },
	"assets": {
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*",
			"/mcp",
			"/mcp/*",
			"/authorize",
			"/oauth/*",
			"/.well-known/*",
			"/resume.pdf"
		]
	},
	"routes": [{ "pattern": "joeyfinkel.com", "custom_domain": true }]
}
